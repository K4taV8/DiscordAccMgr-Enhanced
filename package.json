{
  "name": "discord-account-manager",
  "private": true,
  "version": "1.5.6",
  "description": "A powerful and user-friendly Discord account manager built with Electron.js.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "audit:sca": "npm audit --omit=dev",
    "package": "electron-builder",
    "package:portable": "node -e \"require('fs').writeFileSync('.portable','')\" && electron-builder --win dir && node -e \"require('fs').unlinkSync('.portable')\"",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "discord.js-selfbot-v13": "^3.1.4"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.discord.accoun.tmanager",
    "productName": "Discord Account Manager",
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "src/icons/app-icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      "resources/**"
    ]
  },
  "author": "Bherl1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bherl1/DiscordAccMgr.git"
  },
  "bugs": {
    "url": "https://github.com/Bherl1/DiscordAccMgr/issues"
  },
  "homepage": "https://github.com/Bherl1/DiscordAccMgr"
}
